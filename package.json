{
  "name": "airbridge-drop",
  "version": "1.0.0",
  "description": "AirBridge — Fast, E2EE, open-source AirDrop & Universal Clipboard alternative for Android and MacBook.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "airbridge": "./bin/airbridge.mjs"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/server/index.js",
    "cli": "node ./bin/airbridge.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:desktop": "node scripts/build-desktop.mjs",
    "verify:android": "bash android/scripts/verify.sh"
  },
  "keywords": [
    "airdrop",
    "android",
    "macbook",
    "macos",
    "file-transfer",
    "webrtc",
    "p2p",
    "e2ee",
    "universal-clipboard",
    "localsend",
    "open-source"
  ],
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "bun": "^1.4.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
