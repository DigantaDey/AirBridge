{
  "name": "airbridge-drop",
  "version": "2.5.0",
  "description": "AirBridge — Fast, E2EE, open-source AirDrop & Universal Clipboard alternative for Android and MacBook.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "airbridge": "./bin/airbridge.mjs"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/server/index.js",
    "cli": "node ./bin/airbridge.mjs",
    "typecheck": "tsc --noEmit",
    "lint:js": "eslint .",
    "lint:shell": "shellcheck -S warning install.sh scripts/package-mac-app.sh scripts/test-mac-app.sh macos/AirBridgeQuickSend.workflow.sh",
    "lint:m1_1": "eslint eslint.config.mjs vite.config.ts scripts/build-desktop.mjs scripts/generate-embedded-client.mjs tests/macos-installer.test.ts tests/install-hardening.test.ts tests/build-config-hardening.test.ts && shellcheck -S warning install.sh",
    "lint": "npm run lint:js && npm run lint:shell",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e/",
    "test:e2e:tier1": "vitest run tests/e2e/tier1-feature-coverage",
    "test:e2e:tier2": "vitest run tests/e2e/tier2-boundary-corner",
    "test:e2e:tier3": "vitest run tests/e2e/tier3-cross-feature",
    "test:e2e:tier4": "vitest run tests/e2e/tier4-real-world",
    "test:e2e:watch": "vitest watch tests/e2e/",
    "build:desktop": "node scripts/build-desktop.mjs",
    "verify:android": "bash android/scripts/verify.sh"
  },
  "keywords": [
    "airdrop",
    "android",
    "macbook",
    "macos",
    "file-transfer",
    "webrtc",
    "p2p",
    "e2ee",
    "universal-clipboard",
    "localsend",
    "open-source"
  ],
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "bun": "^1.4.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  }
}
