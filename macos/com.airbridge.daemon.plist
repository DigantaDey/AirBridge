<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional macOS LaunchAgent to run AirBridge Daemon automatically at login.
  Note: `install.sh` and `AirBridge.app` ("Open at Login") manage `com.airbridge.app`
  automatically. If using this standalone CLI plist manually, replace
  /Users/SHARED_OR_USER_PATH/AirBridge with your checkout or binary path.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.airbridge.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>bin/airbridge.mjs</string>
    <string>daemon</string>
    <string>--port</string>
    <string>3000</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>AIRBRIDGE_LOCAL_DAEMON</key>
    <string>1</string>
    <key>AIRBRIDGE_SUPERVISED</key>
    <string>launchd</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/airbridge-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/airbridge-daemon.log</string>
</dict>
</plist>
