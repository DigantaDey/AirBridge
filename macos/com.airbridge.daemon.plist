<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional macOS LaunchAgent to run AirBridge Daemon automatically at login.
  Install:
    cp macos/com.airbridge.daemon.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.airbridge.daemon.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.airbridge.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>./bin/airbridge.mjs</string>
    <string>daemon</string>
    <string>--port</string>
    <string>3000</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AIRBRIDGE_LOCAL_DAEMON</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
