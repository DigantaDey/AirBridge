# Copy to android/keystore.properties and fill with your private Play upload key.
# This file is ignored by Git. Use an absolute path if Android Studio cannot
# resolve a relative one. Do not use the former android/ci.keystore.
AIRBRIDGE_KEYSTORE_FILE=/absolute/path/to/airbridge-upload.jks
AIRBRIDGE_KEYSTORE_PASSWORD=replace-with-store-password
AIRBRIDGE_KEYSTORE_ALIAS=airbridge-upload
AIRBRIDGE_KEYSTORE_KEY_PASSWORD=replace-with-key-password
