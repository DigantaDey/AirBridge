<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 full-backup exclusion rules matching data_extraction_rules.xml:
  exclude all sharedpref, file, database, and root state (including no_backup).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
